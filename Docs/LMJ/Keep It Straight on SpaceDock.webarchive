.well {
    background-color: #EFEFEF;
    border-radius: 0;
    border-left: none;
    border-right: none;
    padding: 0;
    vertical-align: middle;
    margin: 2.5mm;
    margin-top: 2.5 mm;
    margin-bottom: 2.5 mm;
}

